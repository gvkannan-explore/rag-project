#!/usr/bin/env bash
set -uo pipefail
if ! repo_root=$(git rev-parse --show-toplevel); then
    exit 1
fi
failed=0
has_commits=0
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deletions do not introduce commits.
    if [[ "$local_oid" =~ ^0+$ ]]; then
        continue
    fi
    has_commits=1
    if ! bash "$repo_root/scripts/check-secrets.sh" "--log-opts=$local_oid"; then
        failed=1
    fi
done
if [[ "$has_commits" -eq 1 ]]; then
    if ! RAG_NONINTERACTIVE=1 bash "$repo_root/runs/perform_ci.sh" \
        "${RAG_ENV_DIR:-$repo_root/.data}" </dev/null; then
        failed=1
    fi
fi
exit "$failed"
