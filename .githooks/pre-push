#!/usr/bin/env bash
set -uo pipefail
repo_root=$(git rev-parse --show-toplevel)
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deletions do not introduce commits.
    if [[ "$local_oid" =~ ^0+$ ]]; then
        continue
    fi
    bash "$repo_root/scripts/check-secrets.sh" "--log-opts=$local_oid"
done
